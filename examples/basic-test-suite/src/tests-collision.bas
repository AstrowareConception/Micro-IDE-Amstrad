10 MEMORY &7FFF
20 REM @CPCTEST 1 Contact detecte
30 REM @CPCTEST 2 Objets separes
40 x=10:y=20:w=8:h=8:ex=14:ey=24:ew=8:eh=8:GOSUB 1000
50 IF hit THEN POKE &8004,1 ELSE POKE &8004,2
60 ex=30:ey=40:GOSUB 1000
70 IF NOT hit THEN POKE &8005,1 ELSE POKE &8005,2
80 POKE &8000,67:POKE &8001,80:POKE &8002,67:POKE &8003,165
90 END
1000 hit=(x<ex+ew) AND (x+w>ex) AND (y<ey+eh) AND (y+h>ey)
1010 RETURN
