10 MEMORY &7FFF:BORDER 0
20 REM @CPCTEST 1 Entree clavier et fixture
30 REM @CPCFIXTURE SEED.TXT "21\r\n"
40 REM @CPCINPUT 3000 "21\r"
50 REM @CPCFILE RESULT.TXT "42\r\n"
60 REM @CPCSCREEN bord 0 0 8 8 969b87cffdaa289fc07d61efa4d0b8d71d83ac56c4c737cd555dafdbf1cc243c
70 OPENIN "SEED.TXT":INPUT #9,seed:CLOSEIN
80 INPUT "Bonus";bonus
90 total=seed+bonus
100 IF total=42 THEN POKE &8004,1 ELSE POKE &8004,2
110 OPENOUT "RESULT.TXT":PRINT #9,USING "##";total:CLOSEOUT
120 POKE &8000,67:POKE &8001,80:POKE &8002,67:POKE &8003,165
