{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AstrowareConception/Micro-IDE-Amstrad/contracts/basic-test-suites.schema.json",
  "title": "Suites de tests BASIC — version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suites"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "suites": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "sourceIds",
          "seconds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              }
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
