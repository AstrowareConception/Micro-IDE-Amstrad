{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AstrowareConception/Micro-IDE-Amstrad/contracts/agent-task.schema.json",
  "title": "Micro IDE Amstrad agent task — version 1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "kind", "projectId", "objective", "mode", "status", "baseProjectRevision", "corpusVersion", "scope", "allowedTools", "budget"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "kind": {"enum": ["actual", "illustrative"]},
    "projectId": {"type": "string", "format": "uuid"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 20000},
    "mode": {"enum": ["agent", "review", "explain"]},
    "status": {"enum": ["prepared", "running", "paused", "paused-limit", "blocked", "completed", "failed", "cancelled"]},
    "baseProjectRevision": {"type": "integer", "minimum": 0},
    "corpusVersion": {"type": "string", "minLength": 1, "maxLength": 100},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["readPrefixes", "transmitPrefixes", "writePrefixes", "documentIds", "allowCorpus", "allowSessionCapture"],
      "properties": {
        "readPrefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["src/", "assets/", "documents/"]}},
        "transmitPrefixes": {"type": "array", "uniqueItems": true, "items": {"enum": ["src/", "assets/", "documents/"]}},
        "writePrefixes": {"type": "array", "uniqueItems": true, "items": {"enum": ["src/", "assets/generated/"]}},
        "documentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}},
        "allowCorpus": {"type": "boolean"},
        "allowSessionCapture": {"type": "boolean"}
      }
    },
    "allowedTools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxModelTurns", "maxToolCalls", "maxCorrectionCycles", "maxActiveSeconds", "maxTokenUsage", "maxEstimatedCostEur"],
      "properties": {
        "maxModelTurns": {"type": "integer", "minimum": 1, "maximum": 100},
        "maxToolCalls": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxCorrectionCycles": {"type": "integer", "minimum": 0, "maximum": 30},
        "maxActiveSeconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "maxTokenUsage": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxEstimatedCostEur": {"type": ["number", "null"], "minimum": 0}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"mode": {"enum": ["review", "explain"]}}}, "then": {"properties": {"scope": {"properties": {"writePrefixes": {"maxItems": 0}}}, "allowedTools": {"items": {"not": {"enum": ["project.create_source", "project.replace_source", "project.rename_source", "project.remove_source", "assets.convert_screen", "language.renumber"]}}}}}},
    {"if": {"properties": {"mode": {"const": "explain"}}}, "then": {"properties": {"allowedTools": {"items": {"not": {"enum": ["build.project", "emulator.run_build", "emulator.send_input", "emulator.control", "artifacts.prepare_export"]}}}}}}
  ],
  "$defs": {
    "tool": {"enum": ["project.list_files", "project.search", "project.read_file", "project.create_source", "project.replace_source", "project.rename_source", "project.remove_source", "reference.search", "reference.read", "documents.read_text", "documents.inspect_image", "documents.render_pdf_pages", "assets.convert_screen", "assets.inspect", "language.analyze", "language.renumber", "build.project", "emulator.run_build", "emulator.send_input", "emulator.observe", "emulator.control", "artifacts.prepare_export", "task.checkpoint"]}
  }
}
