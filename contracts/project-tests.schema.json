{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AstrowareConception/Micro-IDE-Amstrad/contracts/project-tests.schema.json",
  "title": "Scénarios du vrai projet CPC — version 1",
  "description": "Le validateur applicatif contrôle aussi IDs et noms uniques, 64 touches cumulées, ordre sans chevauchement, fin des saisies dans le budget, rectangle dans 768×272 et aire de 16384 pixels maximum.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "seconds",
          "inputs",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              }
            ]
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "inputs": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "atMs",
                "text"
              ],
              "properties": {
                "atMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15000,
                  "multipleOf": 20
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[\\u000d\\u0020-\\u007e]+$"
                }
              }
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name",
                    "x",
                    "y",
                    "width",
                    "height",
                    "sha256"
                  ],
                  "properties": {
                    "kind": {
                      "const": "screen"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,40}$"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 767
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 271
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 768
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 272
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "file"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Z0-9_]{1,8}(\\.[A-Z0-9_]{1,3})?$"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 2048,
                      "pattern": "^[\\u0009\\u000a\\u000d\\u0020-\\u007e]*$"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
